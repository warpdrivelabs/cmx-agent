{
  "name": "cmx-agent-frontend",
  "private": true,
  "type": "module",
  "postcss-lit": {
    "babelOptions": {
      "sourceType": "unambiguous",
      "plugins": [
        "typescript",
        [
          "decorators",
          {
            "decoratorsBeforeExport": true
          }
        ],
        "decoratorAutoAccessors",
        "jsx"
      ],
      "ranges": true
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "tsc --noEmit && eslint . && prettier --check . && npm run lint:css",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.{ts,css}\"",
    "test": "vitest --run"
  },
  "dependencies": {
    "@ui5/webcomponents": "~2.23.2",
    "@ui5/webcomponents-base": "~2.23.2",
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-lit": "^2.0.0",
    "eslint-plugin-boundaries": "^5.0.0",
    "prettier": "^3.0.0",
    "stylelint": "^17.0.0",
    "postcss-lit": "^1.4.1",
    "@types/node": "^22.0.0"
  }
}
